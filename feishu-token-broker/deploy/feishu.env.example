# /opt/feishu/feishu.env —— Broker 唯一配置文件，root:feishu 0640。
# 未知键会导致启动失败；refresh_token 不在这里，由授权流程写入 /opt/feishu/state/token.json。

# 飞书开放平台 → 应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 客户端 ~/.secrets/feishu.env 里的同名 key，至少 24 位
FEISHU_BROKER_API_KEY=

# 必须同时登记在飞书开放平台 → 安全设置 → 重定向 URL
FEISHU_OAUTH_REDIRECT_URI=https://ft.codewatt.cn/oauth/callback

# 空格分隔的用户权限；offline_access 会自动补上
FEISHU_OAUTH_SCOPE=

FEISHU_BROKER_STATE_DIR=/opt/feishu/state
